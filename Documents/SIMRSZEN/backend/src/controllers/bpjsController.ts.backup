    } catch (error: any) {
      res.status(500).json({
        success: false,
        message: error.message,
        data: null
      });
    }
  }

  /**
   * Update SEP
   */
  static async updateSEP(req: Request, res: Response): Promise<void> {
    try {
      const { noSEP } = req.params;
      const sepData = req.body;

      if (!noSEP || !sepData) {
        res.status(400).json({
          success: false,
          message: 'Nomor SEP dan data SEP wajib disediakan',
          data: null
        });
        return;
      }

      const result = await BpjsService.updateSEP(noSEP, sepData);

      res.status(200).json({
        success: true,
        message: 'SEP berhasil diperbarui',
        data: result
      });
    } catch (error: any) {
      res.status(500).json({
        success: false,
        message: error.message,
        data: null
      });
    }
  }

