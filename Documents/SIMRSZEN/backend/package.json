{
  "name": "simrs-zen-backend",
  "version": "1.0.0",
  "description": "Backend for SIMRS ZEN - Hospital Management System",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "backup": "ts-node scripts/backup.ts",
    "restore": "ts-node scripts/restore.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "simrs",
    "hospital",
    "management",
    "system"
  ],
  "author": "SIMRS ZEN Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^4.16.2",
    "axios": "^1.15.2",
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "lz-string": "^1.5.0",
    "redis": "^5.12.1",
    "uuid": "^14.0.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20.4.2",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.15.10",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prisma": "^4.16.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
