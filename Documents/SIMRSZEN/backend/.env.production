# Database Configuration
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5433/simrszen?schema=public&connection_limit=10"

# JWT Configuration
JWT_SECRET="this_should_be_a_very_long_random_string_for_production_with_at_least_32_characters"
JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100    # Max requests per window

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info