// Schema database untuk SIMRS ZEN
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HospitalProfile {
  id           String   @id @default(uuid())
  hospital_name String?
  hospital_code String?
  address      String?
  phone        String?
  email        String?
  website      String?
  logo_url     String?  // URL logo rumah sakit yang disimpan di MinIO
  enable_bsre_signature Boolean @default(false) // Fitur TTE BSre aktif/tidak
  bsre_api_config Json? // Konfigurasi API untuk integrasi BSre
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String   // Harus disimpan dalam bentuk hash
  full_name            String
  role                 String   // Contoh: admin, staff, doctor
  department           String?
  is_active            Boolean  @default(true)
  last_login           DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model Patient {
  id                   String   @id @default(uuid())
  patient_number       String   @unique  // Nomor rekam medis
  identity_number      String?  // NIK
  name                 String
  date_of_birth        DateTime
  gender               String   // male, female
  phone                String?
  address              String?
  city                 String?
  province             String?
  blood_type           String?  // A, B, AB, O
  marital_status       String?  // single, married, divorced, widowed
  occupation           String?
  education            String?
  religion             String?
  emergency_contact    String?
  insurance_provider   String?  // Nama perusahaan asuransi
  insurance_number     String?  // Nomor kartu asuransi
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model Visit {
  id                   String   @id @default(uuid())
  patient_id           String
  visit_date           DateTime @default(now())
  visit_type           String   // rawat_jalan, rawat_inap, gawat_darurat, kontrol
  department_id        String
  doctor_id            String
  complaint            String?  // Keluhan utama pasien
  diagnosis            String?  // Diagnosa awal
  treatment            String?  // Penanganan awal
  notes                String?  // Catatan dokter
  status               String   // registered, in_progress, completed, cancelled
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  
  patient              Patient  @relation(fields: [patient_id], references: [id])
  department           Department  @relation(fields: [department_id], references: [id])
  doctor               User  @relation(fields: [doctor_id], references: [id])
}

model Department {
  id                   String   @id @default(uuid())
  name                 String
  code                 String   @unique
  description          String?
  head_doctor_id       String?
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model QueueTicket {
  id                   String   @id @default(uuid())
  ticket_number        String   // Contoh: A-001
  service_desk         String   // Nama loket atau layanan
  status               String   // waiting, called, served, cancelled
  patient_id           String
  department_id        String
  issued_at            DateTime @default(now())
  called_at            DateTime?
  served_at            DateTime?
  estimated_wait_time  Int?     // Estimasi waktu tunggu dalam menit
  
  patient              Patient  @relation(fields: [patient_id], references: [id])
  department           Department  @relation(fields: [department_id], references: [id])
}

model SmartDisplayConfig {
  id                   String   @id @default(uuid())
  name                 String   // Nama konfigurasi
  device_type          String   // queue_display, info_display, wayfinding
  department_id        String?
  location             String   // Lokasi layar
  screen_layout        Json?    // Layout layar dalam bentuk JSON
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  
  department           Department?  @relation(fields: [department_id], references: [id])
}

model SmartDisplayDevice {
  id                   String   @id @default(uuid())
  device_name          String
  device_token         String   @unique  // Token otentikasi perangkat
  config_id            String
  last_connected       DateTime?
  is_online            Boolean  @default(false)
  location             String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  
  config               SmartDisplayConfig  @relation(fields: [config_id], references: [id])
}

model AuditLog {
  id                   String   @id @default(uuid())
  table_name           String   // Nama tabel yang diubah
  record_id            String   // ID record yang diubah
  action               String   // INSERT, UPDATE, DELETE
  old_values           Json?    // Nilai lama sebelum perubahan
  new_values           Json?    // Nilai baru setelah perubahan
  user_id              String?  // ID pengguna yang melakukan perubahan
  ip_address           String?  // Alamat IP pengguna
  user_agent           String?  // User agent browser
  created_at           DateTime @default(now())
  
  user                 User?    @relation(fields: [user_id], references: [id])
}

// Tabel-tabel untuk modul akuntansi
model Account {
  id              String   @id @default(uuid())
  account_number  String   @unique
  account_name    String
  account_type    String   // asset, liability, equity, revenue, expense, cash
  parent_account  String?  // Untuk hierarki akun
  balance         Float    @default(0.0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  parent          Account? @relation("AccountHierarchy", fields: [parent_account], references: [id])
  children        Account[] @relation("AccountHierarchy")
  journal_lines   JournalLine[]
}

model Journal {
  id              String   @id @default(uuid())
  journal_number  String   @unique  // Nomor jurnal otomatis
  journal_date    DateTime
  description     String
  total_debit     Float
  total_credit    Float
  posted          Boolean  @default(false)  // Sudah diposting atau belum
  posted_at       DateTime?
  created_by      String   // ID user yang membuat
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  user            User @relation(fields: [created_by], references: [id])
  journal_lines   JournalLine[]
}

model JournalLine {
  id           String   @id @default(uuid())
  journal_id   String
  account_id   String
  debit        Float    @default(0.0)
  credit       Float    @default(0.0)
  description  String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  
  journal      Journal @relation(fields: [journal_id], references: [id])
  account      Account @relation(fields: [account_id], references: [id])
}

// Tabel untuk menyimpan kategori arus kas
model CashFlowCategory {
  id          String   @id @default(uuid())
  name        String   // Nama kategori (Contoh: Pendapatan Operasional)
  type        String   // operating, investing, financing
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  cash_flow_items CashFlowItem[]
}

// Tabel untuk menyimpan item-item laporan arus kas
model CashFlowItem {
  id           String   @id @default(uuid())
  category_id  String
  account_id   String
  name         String   // Nama item arus kas
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  
  category     CashFlowCategory @relation(fields: [category_id], references: [id])
  account      Account @relation(fields: [account_id], references: [id])
}

// Tabel untuk menyimpan data pendapatan dan beban bulanan
model RevenueExpenseItem {
  id          String   @id @default(uuid())
  account_id  String
  period      String   // Format YYYY-MM
  amount      Float
  type        String   // revenue, expense
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  account     Account @relation(fields: [account_id], references: [id])
}

// Tabel untuk menyimpan data arus kas bulanan
model CashItem {
  id          String   @id @default(uuid())
  account_id  String
  period      String   // Format YYYY-MM
  amount      Float
  type        String   // cash_in, cash_out
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  account     Account @relation(fields: [account_id], references: [id])
}

// Tabel untuk rasio keuangan
model FinancialRatio {
  id          String   @id @default(uuid())
  period      String   // Format YYYY-MM
  ratio_type  String   // current_ratio, debt_to_equity, roa, roe, dll
  value       Float
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

// Tabel-tabel untuk modul ambulans
model Ambulance {
  id            String   @id @default(uuid())
  vehicle_number String  @unique
  brand_model   String
  year          Int
  capacity      Int
  status        String   // available, maintenance, on_mission
  driver_name   String
  driver_phone  String
  equipment     Json     // Daftar peralatan dalam bentuk JSON
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model AmbulanceDriver {
  id             String   @id @default(uuid())
  name           String
  license_number String
  phone          String
  shift          String
  status         String   // available, on_duty, off_duty
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
}

model AmbulanceTrip {
  id              String   @id @default(uuid())
  ambulance_id    String
  driver_id       String
  patient_id      String
  pickup_location String
  destination     String
  trip_date       DateTime
  departure_time  String
  arrival_time    String?
  purpose         String   // emergency, transfer, scheduled
  status          String   // pending, in_transit, completed, cancelled
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  
  ambulance       Ambulance @relation(fields: [ambulance_id], references: [id])
  driver          AmbulanceDriver @relation(fields: [driver_id], references: [id])
  patient         Patient @relation(fields: [patient_id], references: [id])
}

// Tabel-tabel untuk form builder
model FormTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  fields      Json     // Struktur field dalam bentuk JSON
  is_active   Boolean  @default(true)
  created_by  String   // ID user yang membuat
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  user        User @relation(fields: [created_by], references: [id])
  form_fields FormField[]
  form_submissions FormSubmission[]
}

model FormField {
  id                String   @id @default(uuid())
  form_template_id  String
  field_order       Int
  field_type        String   // text, textarea, number, date, checkbox, radio, select, section_header
  field_label       String
  field_name        String
  field_placeholder String?
  field_options     Json?    // Opsi untuk radio/select
  is_required       Boolean  @default(false)
  validation_rules  Json?    // Aturan validasi dalam bentuk JSON
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  
  form_template     FormTemplate @relation(fields: [form_template_id], references: [id])
}

model FormSubmission {
  id               String   @id @default(uuid())
  form_template_id String
  patient_id       String
  submitted_data   Json     // Data yang disubmit dalam bentuk JSON
  submitted_by     String   // ID user yang submit
  submitted_at     DateTime @default(now())
  status           String   // draft, submitted, reviewed, approved
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  
  form_template    FormTemplate @relation(fields: [form_template_id], references: [id])
  patient          Patient @relation(fields: [patient_id], references: [id])
  user             User @relation(fields: [submitted_by], references: [id])
}

// Tabel untuk konfigurasi tanda tangan elektronik
model ElectronicSignatureConfig {
  id                     String   @id @default(uuid())
  hospital_profile_id    String
  signature_type         String   // bsre, other
  is_enabled             Boolean  @default(false)
  api_endpoint           String?
  api_key                String?  // Harus disimpan dengan enkripsi
  config_metadata        Json?    // Konfigurasi tambahan dalam bentuk JSON
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  
  hospital_profile       HospitalProfile @relation(fields: [hospital_profile_id], references: [id])
}

// Tabel-tabel untuk modul SDM
model Employee {
  id                   String   @id @default(uuid())
  employee_number      String   @unique  // Nomor pegawai
  full_name            String
  position             String
  department           String
  join_date            DateTime
  employment_status    String   // permanent, contract, probation
  salary_grade         String?  // Golongan gaji
  bank_account         String?  // Nomor rekening
  npwp                 String?  // Nomor Pokok Wajib Pajak
  bpjs_ketenagakerjaan String?  // Nomor BPJS Ketenagakerjaan
  bpjs_kesehatan       String?  // Nomor BPJS Kesehatan
  photo_url            String?  // URL foto karyawan di MinIO
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model LeaveRequest {
  id            String   @id @default(uuid())
  employee_id   String
  leave_type    String   // annual, sick, maternity, etc
  start_date    DateTime
  end_date      DateTime
  reason        String
  status        String   // pending, approved, rejected
  approved_by   String?  // ID user yang menyetujui
  approved_at   DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  employee      Employee @relation(fields: [employee_id], references: [id])
  approver      User? @relation("LeaveApprover", fields: [approved_by], references: [id])
}

model Payroll {
  id             String   @id @default(uuid())
  employee_id    String
  period         String   // Format YYYY-MM
  basic_salary   Float
  allowances     Float    @default(0.0)
  deductions     Float    @default(0.0)
  net_salary     Float
  status         String   // draft, processed, paid
  processed_by   String?  // ID user yang memproses
  processed_at   DateTime?
  paid_at        DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  employee       Employee @relation(fields: [employee_id], references: [id])
  processor      User? @relation("PayrollProcessor", fields: [processed_by], references: [id])
  components     PayrollComponent[]
}

model PayrollComponent {
  id           String   @id @default(uuid())
  payroll_id   String
  component_type String // allowance, deduction
  name         String   // Nama komponen gaji
  amount       Float
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  
  payroll      Payroll @relation(fields: [payroll_id], references: [id])
}

model Attendance {
  id             String   @id @default(uuid())
  employee_id    String
  date           DateTime
  check_in       DateTime
  check_out      DateTime?
  work_duration  Float?   // Durasi kerja dalam jam
  status         String   // present, absent, leave, business_trip, holiday
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  
  employee       Employee @relation(fields: [employee_id], references: [id])
}